# Template only. Copy to .env and put real keys THERE, never in this file (this one is committed).

# Default LLM: Gemini via its OpenAI-compatible endpoint (free tier, key from aistudio.google.com)
OPENAI_COMPAT_API_KEY=
# Optional: leave unset for Gemini, or point it at another OpenAI-compatible server (Ollama, Groq, ...)
# OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Web search + r/nus discovery (free tier, app.tavily.com)
TAVILY_API_KEY=

# NUSMods reviews via Disqus, public key (free, disqus.com/api/applications)
DISQUS_API_KEY=

# Optional
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
